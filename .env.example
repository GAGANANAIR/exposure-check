# All features work with NO keys at all except NumVerify (optional, free tier).
# Copy this file to .env and fill in only what you want.

# Optional — enables NumVerify phone lookups (100 free/month, no card).
# Get one at https://numverify.com/product
NUMVERIFY_API_KEY= "6e4a63919dd6be52c91936106a980e93"

# Optional — port to run the server on
PORT=3000

# Optional — max requests per IP per hour, applied per-endpoint
RATE_LIMIT_PER_HOUR=20

# Optional — how long (minutes) to cache identical lookups before re-querying upstream APIs
CACHE_TTL_MINUTES=60
