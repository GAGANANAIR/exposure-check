# All features work with NO keys at all except NumVerify (optional, free tier).
# Copy this file to .env and fill in only what you want.

# Optional — enables NumVerify phone lookups (100 free/month, no card).
# Get one at https://numverify.com/product
NUMVERIFY_API_KEY=

# Optional — port to run the server on
PORT=3000

# Optional — max requests per IP per hour, applied per-endpoint
RATE_LIMIT_PER_HOUR=20

# Optional — how long (minutes) to cache identical lookups before re-querying upstream APIs
CACHE_TTL_MINUTES=60

# Optional — set this to any long, random string of your choosing to enable
# downloading check_logs.csv via /api/logs?key=<this value>. Leave blank to
# disable log downloads entirely. NEVER hardcode this value in server.js —
# only ever set it here, in your own local .env or your host's env settings.
LOGS_ACCESS_KEY=

# Optional — enables persistent logging to a private GitHub repo, so log
# data survives Render restarts/redeploys instead of living only on the
# ephemeral local filesystem. Create a private repo, generate a
# fine-grained PAT scoped to just that repo with "Contents: Read and write",
# and fill these in. Leave GITHUB_LOG_TOKEN blank to disable this entirely.
GITHUB_LOG_TOKEN=
GITHUB_LOG_REPO=GAGANANAIR/exposure-check-logs
GITHUB_LOG_PATH=check_logs.csv
GITHUB_LOG_BRANCH=main
